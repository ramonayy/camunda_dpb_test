        </outputEntry>
      </rule>
      <rule id="DecisionRule_0sqhapk">
        <inputEntry id="UnaryTests_1te7q3x">
          <text>requestedQuantity</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1617w4x">
          <text>requestedQuantity * 4</text>
        </outputEntry>
