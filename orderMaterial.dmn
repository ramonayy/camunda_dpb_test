      <output id="Output_1" name="orderedMaterial" typeRef="number" />
      <rule id="DecisionRule_02no04v">
        <inputEntry id="UnaryTests_17wudk0">
          <text>&lt; requestedQuantity</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0jepoo7">
          <text>requestedQuantity * 5</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1nesrwq">
        <inputEntry id="UnaryTests_1l271f2">
          <text>&gt; requestedQuantity</text>
